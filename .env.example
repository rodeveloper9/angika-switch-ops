# Angika UAT — never commit real secrets
ANGIKA_API_BASE_URL=https://uat.angikafoods.com

# mock = local JSON | uat = live public catalogue (+ admin for orders)
ANGIKA_TOOLS_MODE=mock

# Only required for order-status in uat mode (admin Bearer JWT, ~1 hour)
# Catalog tools do NOT need a token — they use public online offer prices
# ANGIKA_API_TOKEN=
